# ── API connection ────────────────────────────────────────────────────────────

# Public base URL of the API — used by browser-side code.
# Dev:  http://localhost:3000/api
# Prod: set to /backend so the Next.js rewrite proxy is used (recommended)
#       This keeps the real API URL hidden from the browser and avoids CORS.
NEXT_PUBLIC_API_URL=/backend

# Internal URL the Next.js server uses to proxy /backend/* requests to the API.
# Dev:  http://localhost:3000/api
# Prod: https://your-railway-app.railway.app/api
INTERNAL_API_URL=http://localhost:3000/api
